56","source":"HAMAP-Rule","id":"MF_01227"}],"value":"Catalyzes the ATP-dependent amination of UTP to CTP with either L-glutamine or ammonia as the source of nitrogen. Regulates intracellular CTP levels through interactions with the four ribonucleotide triphosphates"}],"commentType":"FUNCTION"},{"commentType":"CATALYTIC ACTIVITY","reaction":{"name":"L-glutamine + H2O = L-glutamate + NH4(+)","reactionCrossReferences":[{"database":"Rhea","id":"RHEA:15889"},{"database":"ChEBI","id":"CHEBI:15377"},{"database":"ChEBI","id":"CHEBI:28938"},{"database":"ChEBI","id":"CHEBI:29985"},{"database":"ChEBI","id":"CHEBI:58359"}],"evidences":[{"evidenceCode":"ECO:0000256","source":"HAMAP-Rule","id":"MF_01227"}]}},{"commentType":"CATALYTIC ACTIVITY","reaction":{"name":"UTP + L-glutamine + ATP + H2O = CTP + L-glutamate + ADP + phosphate + 2 H(+)","reactionCrossReferences":[{"database":"Rhea","id":"RHEA:26426"},{"database":"ChEBI","id":"CHEBI:15377"},{"database":"ChEBI","id":"CHEBI:15378"},{"database":"ChEBI","id":"CHEBI:29985"},{"database":"ChEBI","id":"CHEBI:30616"},{"database":"ChEBI","id":"CHEBI:37563"},{"database":"ChEBI","id":"CHEBI:43474"},{"database":"ChEBI","id":"CHEBI:46398"},{"database":"ChEBI","id":"CHEBI:58359"},{"database":"ChEBI","id":"CHEBI:456216"}],"ecNumber":"6.3.4.2","evidences":[{"evidenceCode":"ECO:0000256","source":"ARBA","id":"ARBA00047781"},{"evidenceCode":"ECO:0000256","source":"HAMAP-Rule","id":"MF_01227"}]}},{"commentType":"CATALYTIC ACTIVITY","reaction":{"name":"UTP + NH4(+) + ATP = CTP + ADP + phosphate + 2 H(+)","reactionCrossReferences":[{"database":"Rhea","id":"RHEA:16597"},{"database":"ChEBI","id":"CHEBI:15378"},{"database":"ChEBI","id":"CHEBI:28938"},{"database":"ChEBI","id":"CHEBI:30616"},{"database":"ChEBI","id":"CHEBI:37563"},{"database":"ChEBI","id":"CHEBI:43474"},{"database":"ChEBI","id":"CHEBI:46398"},{"database":"ChEBI","id":"CHEBI:456216"}],"evidences":[{"evidenceCode":"ECO:0000256","source":"HAMAP-Rule","id":"MF_01227"}]}},{"texts":[{"evidences